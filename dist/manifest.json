{
  "manifest_version": 3,
  "name": "MercedTime",
  "version": "0.1.0",
  "description": "A faster front-end for UC Merced's Banner registration pages.",
  "permissions": ["storage"],
  "host_permissions": ["https://reg-prod.ec.ucmerced.edu/*"],
  "content_scripts": [
    {
      "matches": ["https://reg-prod.ec.ucmerced.edu/StudentRegistrationSsb/ssb/*"],
      "js": ["mercedtime.js"],
      "run_at": "document_idle"
    }
  ]
}
