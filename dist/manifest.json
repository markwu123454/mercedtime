{
  "manifest_version": 3,
  "name": "MercedTime",
  "version": "0.1.0",
  "description": "A faster front-end for UC Merced's Banner registration pages.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://reg-prod.ec.ucmerced.edu/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "redirect", "enabled": true, "path": "rules.json" }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["app.html"],
      "matches": ["https://reg-prod.ec.ucmerced.edu/*"]
    }
  ]
}
